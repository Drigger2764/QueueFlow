# Database Configuration
DATABASE_URL=postgresql://queueflow:queueflow_password@localhost:5432/queueflow
# For standalone local run without Postgres:
# DATABASE_URL=sqlite:///./queueflow.db

# Redis Broker Configuration
REDIS_URL=redis://localhost:6379/0

# Worker Settings
EMBEDDED_WORKER=true
WORKER_ID=worker-node-local-1
QUEUES=default,critical,low
DEFAULT_MAX_RETRIES=3
DEFAULT_RETRY_BACKOFF_BASE=2

# Security & HMAC Secret
SECRET_KEY=queueflow-production-secret-key-change-me
